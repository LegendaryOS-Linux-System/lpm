[package]
-> name        => lpm
-> version     => 0.2.0
-> description => LegendaryOS Package Manager — niezmienny menedżer pakietów: warstwy w obrazie (FastTree, styl rpm-ostree) + magazyn /packages (styl nix) + narzędzia /tools (squashfs)
-> authors     => ["LegendaryOS Team"]
-> license     => MIT
-> keywords    => ["lpm", "fasttree", "immutable", "fedora", "zenitd", "legendaryos"]
-> readme      => README.md
-> lang        => [h#, z#, hl]

! nula wykrywa biblioteki w kodzie (use "bit -> libfasttree" / "bit -> lrpm" w src/main.h#).
! Od 0.2.0 NIE MA sekcji [vendor] ani skryptu vendor-fasttree.sh: libfasttree jest używany jako biblioteka
! (fasada ft::api::*, zob. ../libfasttree/docs/USING-AS-LIBRARY.md), a RPM/satsolv — przez ../lrpm. lpm nie zakłada dnf.
[pins]
-> libfasttree => path ../libfasttree
-> lrpm => path ../lrpm

[layout]
-> src         => src
-> mod         => mod
-> source-code => source-code
-> build       => build

[commands]
-> check
--> run => bit check
--> description => Sprawdź typy
-> test
--> run => h# test src/tests/remap_test.h#
--> description => Test remap_tree (wymaga >4 GB RAM: import bibliotek bit — N4). Czysta logika: ../lrpm/scripts/run-tests.sh
