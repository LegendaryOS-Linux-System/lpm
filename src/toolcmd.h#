use "std -> fs" from "fs"
mod text
mod layout
mod lmanifest
mod tools
mod hk
mod ui
mod config

;; /tools: narzędzia HackerOS i Zenit Linux (git -> squashfs, montowane ro).
;; Katalog narzędzi (tools.hk, dostarczany w obrazie):
;;   [tools]
;;   -> hacker
;;   --> git   => https://github.com/HackerOS-Linux-System/hacker
;;   --> entry => bin/hacker
;;   --> build => ""                ;; opcjonalne polecenie budowy

pub fn catalog_names(d: hk::Doc) -> [string] is
    let mut out: [string] = []
    let ks: [string] = hk::keys(d, "tools")
    let mut i: int = 0
    while i < ks.len() is
        if text::ends_with(ks[i], ".git") is out.push(ks[i][0..ks[i].len() - 4]) end
        i += 1
    end
    return out
end

fn load_catalog(c: config::Config) -> hk::ParseResult is
    return hk::load(c.tools_catalog)
end

fn spec_from_catalog(d: hk::Doc, name: string) -> tools::ToolSpec is
    return tools::new_spec(name, hk::get(d, "tools", name + ".git", ""),
        hk::get(d, "tools", name + ".rev", ""), hk::get(d, "tools", name + ".entry", ""),
        hk::get(d, "tools", name + ".build", ""))
end

fn need_root(c: config::Config) -> bool is
    if c.dry_run || config::is_root() is return true end
    ui::err("ta operacja wymaga roota (/tools jest tylko do odczytu)")
    return false
end

pub fn pack_one(c: config::Config, spec: tools::ToolSpec) -> int is
    if spec.git == "" is
        ui::err("narzędzie '" + spec.name + "' nie ma adresu git w katalogu")
        return 1
    end
    ui::info("klonowanie i pakowanie " + spec.name + " (" + spec.git + ")")
    if c.dry_run is
        ui::ok("dry-run: " + spec.name)
        return 0
    end
    let ue: string = layout::unlock_mutable(c.l)
    if ue != "" is
        ui::err(ue)
        return 1
    end
    let r: tools::ToolResult = tools::pack(c.l, spec)
    let le: string = layout::lock_mutable(c.l)
    if !r.ok is
        ui::err(r.error)
        return 1
    end
    ui::ok(r.name + " @ " + r.commit[0..12] + "  " + text::istr(r.size / 1024) + " KiB (squashfs zstd)")
    return 0
end

;; lpm tools add <nazwa> [git entry]  — z katalogu albo jawnie
pub fn add(c: config::Config, args: [string]) -> int is
    if args.len() == 0 is
        ui::err("lpm tools add <nazwa> [<git> <entry>]")
        return 1
    end
    if !need_root(c) is return 1 end
    if args.len() >= 3 is
        return pack_one(c, tools::new_spec(args[0], args[1], "", args[2], ""))
    end
    let cat: hk::ParseResult = load_catalog(c)
    if !cat.ok is
        ui::err("katalog narzędzi (" + c.tools_catalog + "): " + cat.error)
        return 1
    end
    let spec: tools::ToolSpec = spec_from_catalog(cat.doc, args[0])
    return pack_one(c, spec)
end

pub fn add_all(c: config::Config) -> int is
    if !need_root(c) is return 1 end
    let cat: hk::ParseResult = load_catalog(c)
    if !cat.ok is
        ui::err("katalog narzędzi: " + cat.error)
        return 1
    end
    let names: [string] = catalog_names(cat.doc)
    let mut fails: int = 0
    let mut i: int = 0
    while i < names.len() is
        let rc: int = pack_one(c, spec_from_catalog(cat.doc, names[i]))
        if rc != 0 is fails += 1 end
        i += 1
    end
    return fails
end

pub fn update(c: config::Config, name: string) -> int is
    if !need_root(c) is return 1 end
    let m: lmanifest::ParseResult = tools::info(c.l, name)
    if !m.ok is
        ui::err("narzędzie '" + name + "' nie jest zainstalowane")
        return 1
    end
    return pack_one(c, tools::new_spec(name, lmanifest::get(m.doc, "tool", "git", ""),
        lmanifest::get(m.doc, "tool", "rev", ""), lmanifest::get(m.doc, "tool", "entry", ""), ""))
end

pub fn list(c: config::Config) -> int is
    let t: [string] = tools::list(c.l)
    let mut i: int = 0
    while i < t.len() is
        let m: lmanifest::ParseResult = tools::info(c.l, t[i])
        let mut mark: string = "odmontowane"
        if tools::is_mounted(c.l, t[i]) is mark = "zamontowane" end
        write("  " + t[i] + "  " + lmanifest::get(m.doc, "tool", "commit", "")[0..12] + "  " + mark)
        i += 1
    end
    if t.len() == 0 is ui::info("brak zainstalowanych narzędzi (lpm tools add-all)") end
    return 0
end

pub fn catalog(c: config::Config) -> int is
    let cat: hk::ParseResult = load_catalog(c)
    if !cat.ok is
        ui::err("katalog narzędzi (" + c.tools_catalog + "): " + cat.error)
        return 1
    end
    let names: [string] = catalog_names(cat.doc)
    let mut i: int = 0
    while i < names.len() is
        write("  " + names[i] + "  " + hk::get(cat.doc, "tools", names[i] + ".git", ""))
        i += 1
    end
    return 0
end

pub fn mount_all(c: config::Config) -> int is
    let t: [string] = tools::list(c.l)
    let mut fails: int = 0
    let mut i: int = 0
    while i < t.len() is
        let e: string = tools::mount_tool(c.l, t[i])
        if e != "" is
            ui::err(t[i] + ": " + e)
            fails += 1
        end
        i += 1
    end
    return fails
end

;; Zamontuj (jeśli trzeba) i wypisz ścieżkę pliku wykonywalnego — używa jej `legendary-tool`.
pub fn path(c: config::Config, name: string) -> int is
    let e: string = tools::mount_tool(c.l, name)
    if e != "" is
        ui::err(e)
        return 1
    end
    let p: string = tools::entry_path(c.l, name)
    if p == "" is
        ui::err("narzędzie '" + name + "' nie ma zdefiniowanego entry")
        return 1
    end
    write(p)
    return 0
end

pub fn remove(c: config::Config, name: string) -> int is
    if !need_root(c) is return 1 end
    let ue: string = layout::unlock_mutable(c.l)
    let e: string = tools::remove(c.l, name)
    let le: string = layout::lock_mutable(c.l)
    if e != "" is
        ui::err(e)
        return 1
    end
    ui::ok("usunięto " + name)
    return 0
end
