use "std -> fs" from "fs"
mod text
mod sys
mod layout

;; Dziennik transakcji lpm: /state/lpm/journal/current. Jedna transakcja naraz;
;; po awarii (zabity proces) lpm wykrywa przeterminowany wpis i czyści katalog tmp.
;; Same zmiany systemu są atomowe (nowy tag + podmiana symlinku), więc awaria
;; nie zostawia półzmienionego systemu — najwyżej śmieci w /state/lpm/tmp.

fn cur_path(l: layout::Layout) -> string is
    return text::path_join(layout::lpm_journal(l), "current")
end

pub fn tmp_root(l: layout::Layout) -> string is
    return text::path_join(layout::lpm_dir(l), "tmp")
end

fn pid_alive(pid: int) -> bool is
    if pid <= 0 is return false end
    return sys::ok("kill -0 " + text::istr(pid) + " 2>/dev/null")
end

;; "" gdy OK; inaczej komunikat (inna transakcja trwa).
pub fn begin(l: layout::Layout, op: string) -> string is
    fs_mkdir(layout::lpm_journal(l))
    let p: string = cur_path(l)
    if fs::exists(p) is
        let parts: [string] = text::split(text::trim(fs::read(p)), " ")
        let pid: int = text::parse_int(parts[0], 0)
        if pid_alive(pid) is
            return "inna transakcja lpm trwa (pid " + text::istr(pid) + ": " + text::join(parts, " ") + ")"
        end
        sys::rm_rf(tmp_root(l))
    end
    if !fs::write(p, text::istr(sys::pid()) + " " + op) is return "nie można zapisać dziennika " + p end
    return ""
end

fn fs_mkdir(p: string) is sys::mkdir_p(p) end

pub fn commit(l: layout::Layout) is
    sys::rm_f(cur_path(l))
    sys::rm_rf(tmp_root(l))
end

;; Opis przeterminowanej transakcji albo "".
pub fn stale(l: layout::Layout) -> string is
    let p: string = cur_path(l)
    if !fs::exists(p) is return "" end
    let t: string = text::trim(fs::read(p))
    let pid: int = text::parse_int(text::split(t, " ")[0], 0)
    if pid_alive(pid) is return "" end
    return t
end
