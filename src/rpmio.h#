use "std -> fs" from "fs"
mod text
mod sys
mod plan
mod config

;; Operacje na RPM: pobranie domknięcia (dnf), inspekcja (rpm -qp), rozpakowanie
;; (rpm2cpio | cpio) i przemapowanie ścieżek na układ LegendaryOS. Skrypty RPM
;; (%post itd.) NIE są uruchamiane (niezmienny obraz) — zob. docs/ROADMAP.md.

pub struct RpmInfo is
    pub path:     string
    pub name:     string
    pub version:  string
    pub release:  string
    pub arch:     string
    pub sha256:   string
    pub requires: [string]
    pub provides: [string]
end

pub struct InspectResult is
    pub ok:    bool
    pub error: string
    pub info:  RpmInfo
end

fn tag(name: string) -> string is
    return "%" + text::lbrace() + name + text::rbrace()
end

pub fn nevra(i: RpmInfo) -> string is
    return i.name + "-" + i.version + "-" + i.release + "." + i.arch
end

pub fn inspect(path: string) -> InspectResult is
    let bad: RpmInfo = RpmInfo { path: path, name: "", version: "", release: "", arch: "", sha256: "", requires: [], provides: [] }
    if !sys::have_tool("rpm") is return InspectResult { ok: false, error: "brak narzędzia rpm", info: bad } end
    let fmt: string = tag("NAME") + "\\n" + tag("VERSION") + "\\n" + tag("RELEASE") + "\\n" + tag("ARCH") + "\\n"
    let a: sys::Exec = sys::exec("rpm -qp --qf " + sys::sq(fmt) + " " + sys::sq(path))
    let f: [string] = text::lines(a.out)
    if a.code != 0 || f.len() < 4 is
        return InspectResult { ok: false, error: "rpm -qp " + path + ": " + text::trim(a.out), info: bad }
    end
    let rq: sys::Exec = sys::exec("rpm -qp --qf " + sys::sq("[" + tag("REQUIRENAME") + "\\n]") + " " + sys::sq(path))
    let pv: sys::Exec = sys::exec("rpm -qp --qf " + sys::sq("[" + tag("PROVIDENAME") + "\\n]") + " " + sys::sq(path))
    let sh: sys::Exec = sys::exec("sha256sum " + sys::sq(path))
    let digest: string = text::split(text::trim(sh.out), " ")[0]
    return InspectResult { ok: true, error: "", info: RpmInfo { path: path, name: f[0], version: f[1], release: f[2],
        arch: f[3], sha256: digest, requires: text::lines(rq.out), provides: text::lines(pv.out) } }
end

pub fn node_of(i: RpmInfo) -> plan::Node is
    let mut req: [string] = []
    let mut k: int = 0
    while k < i.requires.len() is
        let r: string = i.requires[k]
        k += 1
        if r != "" && !text::starts_with(r, "/") is req.push(r) end
    end
    return plan::Node { name: i.name, requires: req, provides: i.provides }
end

pub struct DownloadResult is
    pub ok:    bool
    pub error: string
    pub files: [string]
end


;; Pobiera RPM-y potrzebne do zainstalowania `pkgs` RELATYWNIE do działającego
;; systemu (--resolve): to, co baza już ma (glibc, Mesa, sterowniki NVIDIA),
;; NIE jest pobierane i pozostaje źródłem prawdy z /system.
pub fn download_closure(c: config::Config, pkgs: [string], dest: string) -> DownloadResult is
    if !sys::have_tool(c.dnf) is
        return DownloadResult { ok: false, error: "brak " + c.dnf + " w systemie (backend dnf)", files: [] }
    end
    sys::mkdir_p(dest)
    let mut cmd: string = c.dnf + " download --resolve --releasever=" + c.releasever + " --destdir=" + sys::sq(dest)
    let mut i: int = 0
    while i < pkgs.len() is
        if !plan::safe_pkg_name(pkgs[i]) is
            return DownloadResult { ok: false, error: "niepoprawna nazwa pakietu: '" + pkgs[i] + "'", files: [] }
        end
        cmd = cmd + " " + sys::sq(pkgs[i])
        i += 1
    end
    let r: sys::Exec = sys::exec(cmd)
    if r.code != 0 is return DownloadResult { ok: false, error: c.dnf + " download: " + text::trim(r.out), files: [] } end
    let mut files: [string] = []
    let all: [string] = fs::list_dir(dest)
    let mut k: int = 0
    while k < all.len() is
        if text::ends_with(all[k], ".rpm") is files.push(text::path_join(dest, all[k])) end
        k += 1
    end
    return DownloadResult { ok: true, error: "", files: files }
end

pub fn extract(rpm: string, raw_dir: string) -> string is
    if !sys::have_tool("rpm2cpio") || !sys::have_tool("cpio") is return "brak rpm2cpio/cpio" end
    sys::mkdir_p(raw_dir)
    let r: sys::Exec = sys::exec("rpm2cpio " + sys::sq(rpm) + " | cpio -idmu --quiet --no-absolute-filenames -D " + sys::sq(raw_dir))
    if r.code != 0 is return "rozpakowanie " + rpm + ": " + text::trim(r.out) end
    return ""
end


pub fn search(c: config::Config, term: string) -> string is
    if !plan::safe_pkg_name(term) is return "niepoprawny termin" end
    let r: sys::Exec = sys::exec(c.dnf + " search --releasever=" + c.releasever + " " + sys::sq(term))
    return r.out
end

pub fn remap_tree(raw_dir: string, out_dir: string) -> [string] is
    return plan::remap_tree(raw_dir, out_dir)
end
