;; Warstwa RPM lpm — cienki adapter na bibliotekę lrpm (satsolv). BRAK dnf:
;;   planowanie/pobranie: rp::txn::flat_prepare (sync metadanych, solver względem installed.xml, atrapy systemd,
;;                         pobranie, sha256, GPG)
;;   rozpakowanie:         rp::extract::extract (bsdtar)
;;   inspekcja zależności: `rpm -qp` (tylko dla `lpm add` — DAG magazynu /packages); wymaga pakietu rpm
;; Skrypty RPM (%post itd.) NIE są uruchamiane — zob. lrpm/docs/POLICY.md i `lpm triggers`.

;; Wynik planowania jako tablice RÓWNOLEGŁE (typy proste; bez struktur z biblioteki).
pub struct Txn is
    pub ok:       bool
    pub error:    string
    pub problems: [string]
    pub names:    [string]
    pub nevras:   [string]
    pub files:    [string]   ;; ścieżki RPM w cache
    pub repos:    [string]
    pub evrs:     [string]   ;; ver-rel
    pub arches:   [string]
    pub shas:     [string]
    pub blocks:   string     ;; plik z blokami <package> dla installed.xml
end

fn txn_fail(msg: string, problems: [string]) -> Txn is
    return Txn { ok: false, error: msg, problems: problems, names: [], nevras: [], files: [], repos: [],
        evrs: [], arches: [], shas: [], blocks: "" }
end

;; Rozwiązuje `want` względem działającego systemu. `download` = false → tylko plan (dry-run).
pub fn prepare(c: config::Config, want: [string], download: bool) -> Txn is
    let rows: [string] = rp::txn::flat_prepare(config::cache(c), c.repos_file, c.policy_file, c.releasever, c.arch,
        config::installed_xml(c), want, download)
    let t: string = rp::pure::tab()
    let mut problems: [string] = []
    let mut names: [string] = []
    let mut nevras: [string] = []
    let mut files: [string] = []
    let mut repos: [string] = []
    let mut evrs: [string] = []
    let mut arches: [string] = []
    let mut shas: [string] = []
    let mut blocks: string = ""
    let mut i: int = 0
    while i < rows.len() is
        let f: [string] = rp::pure::split(rows[i], t)
        i += 1
        if f[0] == "E" && f.len() > 1 is
            let mut probs: [string] = []
            let mut k: int = i
            while k < rows.len() is
                let g: [string] = rp::pure::split(rows[k], t)
                if g[0] == "P" && g.len() > 1 is probs.push(g[1]) end
                k += 1
            end
            return txn_fail(f[1], probs)
        end
        if f[0] == "S" && f.len() >= 9 is
            names.push(f[1])
            nevras.push(f[2])
            files.push(f[3])
            repos.push(f[4])
            evrs.push(f[5])
            arches.push(f[6])
            shas.push(f[7])
        end
        if f[0] == "B" && f.len() > 1 is blocks = f[1] end
    end
    return Txn { ok: true, error: "", problems: problems, names: names, nevras: nevras, files: files, repos: repos,
        evrs: evrs, arches: arches, shas: shas, blocks: blocks }
end

pub fn extract(rpm: string, raw_dir: string) -> string is
    return rp::extract::extract(rpm, raw_dir)
end

pub fn remap_tree(raw_dir: string, out_dir: string) -> [string] is
    return plan::remap_tree(raw_dir, out_dir)
end

pub fn sync(c: config::Config) -> string is
    return rp::txn::sync_flat(config::cache(c), c.repos_file, c.releasever, c.arch)
end

pub fn search(c: config::Config, term: string) -> [string] is
    return rp::txn::search_flat(config::cache(c), c.repos_file, c.releasever, c.arch, term)
end

;; ── inspekcja pojedynczego RPM (zależności do DAG magazynu /packages) ───────

pub struct RpmInfo is
    pub path:     string
    pub name:     string
    pub version:  string
    pub release:  string
    pub arch:     string
    pub sha256:   string
    pub requires: [string]
    pub provides: [string]
end

pub struct InspectResult is
    pub ok:    bool
    pub error: string
    pub info:  RpmInfo
end

fn tag(name: string) -> string is
    return "%" + ft::text::lbrace() + name + ft::text::rbrace()
end

pub fn nevra(i: RpmInfo) -> string is
    return i.name + "-" + i.version + "-" + i.release + "." + i.arch
end

pub fn inspect(path: string) -> InspectResult is
    let bad: RpmInfo = RpmInfo { path: path, name: "", version: "", release: "", arch: "", sha256: "", requires: [], provides: [] }
    if !ft::sys::have_tool("rpm") is return InspectResult { ok: false, error: "brak narzędzia rpm (potrzebne do `lpm add`)", info: bad } end
    let fmt: string = tag("NAME") + "\\n" + tag("VERSION") + "\\n" + tag("RELEASE") + "\\n" + tag("ARCH") + "\\n"
    let a: sys::Exec = ft::sys::exec("rpm -qp --qf " + ft::sys::sq(fmt) + " " + ft::sys::sq(path))
    let f: [string] = ft::text::lines(a.out)
    if a.code != 0 || f.len() < 4 is
        return InspectResult { ok: false, error: "rpm -qp " + path + ": " + ft::text::trim(a.out), info: bad }
    end
    let rq: sys::Exec = ft::sys::exec("rpm -qp --qf " + ft::sys::sq("[" + tag("REQUIRENAME") + "\\n]") + " " + ft::sys::sq(path))
    let pv: sys::Exec = ft::sys::exec("rpm -qp --qf " + ft::sys::sq("[" + tag("PROVIDENAME") + "\\n]") + " " + ft::sys::sq(path))
    let sh: sys::Exec = ft::sys::exec("sha256sum " + ft::sys::sq(path))
    let digest: string = ft::text::split(ft::text::trim(sh.out), " ")[0]
    return InspectResult { ok: true, error: "", info: RpmInfo { path: path, name: f[0], version: f[1], release: f[2],
        arch: f[3], sha256: digest, requires: ft::text::lines(rq.out), provides: ft::text::lines(pv.out) } }
end

pub fn node_of(i: RpmInfo) -> lpath::Node is
    let mut req: [string] = []
    let mut k: int = 0
    while k < i.requires.len() is
        let r: string = i.requires[k]
        k += 1
        if r != "" && !rp::pure::starts_with(r, "/") is req.push(r) end
    end
    return rp::lpath::node(i.name, req, i.provides)
end
