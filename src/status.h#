use "std -> fs" from "fs"
mod ui
mod config
mod journal

pub fn status(c: config::Config) -> int is
    let root: string = c.root
    ui::head("status systemu")
    let cur: string = ft::api::current_tag(config::ft_root(c))
    let prev: string = ft::api::previous_tag(config::ft_root(c))
    let name: string = ft::api::system_manifest_get(root, "os", "name")
    if name != "" is
        ui::kv("system", name + " " + ft::api::system_manifest_get(root, "os", "version"))
        ui::kv("baza", ft::api::system_manifest_get(root, "os", "base") + " " + ft::api::system_manifest_get(root, "os", "base_release"))
        ui::kv("init", ft::api::system_manifest_get(root, "init", "service_manager"))
        ui::kv("generacja", ft::api::system_manifest_get(root, "deployment", "generation"))
        ui::kv("warstwy", ft::text::istr(ft::api::system_manifest_layers(root)))
    else is
        ui::warn("brak manifest.toml systemu")
    end
    ui::kv("tag aktywny", cur)
    ui::kv("tag poprzedni", prev)
    let pend: string = ft::api::pending_tag(root)
    if pend != "" is ui::kv("oczekujące", pend + "  (aktywne po restarcie)") end
    ui::kv("profil", "generacja " + ft::text::istr(ft::api::profile_generation(root)) + ", korzeni: " + ft::text::istr(ft::api::profile_roots(root).len()))
    ui::kv("narzędzia", ft::text::istr(ft::api::tool_count(root)))
    let st: string = journal::stale(root)
    if st != "" is ui::warn("przerwana transakcja: " + st + " (zostanie wyczyszczona przy następnej operacji)") end
    return 0
end

;; lpm doctor: układ, manifest, repozytoria, narzędzia zewnętrzne (BEZ dnf — wymagane: curl gawk bsdtar …).
pub fn doctor(c: config::Config) -> int is
    ui::head("doctor")
    let mut bad: int = 0
    let p: [string] = ft::api::layout_validate(c.root)
    let mut i: int = 0
    while i < p.len() is
        ui::warn(p[i])
        bad += 1
        i += 1
    end
    if p.len() == 0 is ui::ok("układ plików poprawny") end
    let mp: [string] = ft::api::system_manifest_check(c.root)
    let mut k: int = 0
    while k < mp.len() is
        ui::warn("manifest.toml: " + mp[k])
        bad += 1
        k += 1
    end
    if mp.len() == 0 is ui::ok("manifest.toml poprawny") end
    let re: string = rp::conf::check(c.repos_file, c.releasever, c.arch)
    if re != "" is
        ui::warn("repozytoria: " + re)
        bad += 1
    else is
        ui::ok("repozytoria: " + c.repos_file)
    end
    if !fs::exists(config::installed_xml(c)) is
        ui::warn("brak " + config::installed_xml(c) + " — solver nie zna bazy systemu (obraz zbudowany bez lepm?)")
        bad += 1
    end
    let need: [string] = ["git", "mksquashfs", "curl", "gawk", "bsdtar", "zstd", "sha256sum", "rpm", "mkcomposefs", "veritysetup"]
    let mut t: int = 0
    while t < need.len() is
        if ft::sys::have_tool(need[t]) is ui::ok("narzędzie: " + need[t]) else is
            ui::warn("brak narzędzia: " + need[t])
            bad += 1
        end
        t += 1
    end
    if bad > 0 is return 1 end
    return 0
end
